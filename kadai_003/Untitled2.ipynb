      "source": [
        "import numpy as np\n",
        "A = np.array([[0, 1], [2, 3], [4, 5]])\n",
        "B = np.array([[0, 1, 2, 3], [4, 5, 6, 7]])\n",
        "result_matrix = np.dot(A, B)\n",
        "print(f\"行列の積:\\n{result_matrix}\")\n",
        "max_value = result_matrix.max()\n",
        "print(f\"行列の要素の最大値: {max_value}\")"
      ],
